OPCUA_URL=opc.tcp://AKOMI2-CX2030:4840
OPCUA_NAMESPACE=4
OPCUA_CONNECT_TIMEOUT=5
OPCUA_POLL_INTERVAL=0.25
OPCUA_STALE_AFTER=3.0
DASHBOARD_REFRESH_MS=1000
HISTORY_SECONDS=300

# Persist live OPC UA telemetry into data/recordings/
RECORD_LIVE=true
# Replay recorded telemetry according to timestamps
REPLAY_SPEED=1.0
